model User {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  email     String @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  stockMovements StockMovement[]

  purchasesCreated  Purchase[]
  salesCreated      Sale[]
  transfersCreated  Transfer[]

  adjustmentsCreated  Adjustment[] @relation("AdjustmentCreatedBy")
  adjustmentsApproved Adjustment[] @relation("AdjustmentApprovedBy")
}

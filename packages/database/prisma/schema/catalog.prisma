model Category {
  id String @id @default(cuid())

  businessId String

  name String

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  products Product[]
}

model Product {
  id String @id @default(cuid())

  businessId String
  categoryId String?

  name        String
  description String?

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  // FIX: original had `movements StockMovement[]` and
  // `purchaseItems PurchaseItem[]` here, but neither StockMovement nor
  // PurchaseItem declared a matching productId/product field — this alone
  // breaks `prisma generate`. Since every StockMovement and PurchaseItem
  // already resolves back to a Product through its variant, these were
  // dropped rather than patched with a redundant productId column.

  @@index([businessId])
  @@index([categoryId])
}

model ProductBatch {
  id String @id @default(cuid())

  variantId   String
  warehouseId String

  batchNumber String

  manufactureDate DateTime?
  expiryDate      DateTime?
  receivedDate    DateTime?

  // Source of truth for batch-tracked quantity. Stock.quantity for the same
  // (warehouseId, variantId) should always equal the sum of these rows —
  // see the note on the Stock model in inventory.prisma.
  quantity Decimal @default(0)
  unitCost Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  saleItems       SaleItem[]
  transferItems   TransferItem[]
  adjustmentItems AdjustmentItem[]
  purchaseItems   PurchaseItem[]
  stockMovements  StockMovement[]

  @@unique([warehouseId, variantId, batchNumber])
  @@index([expiryDate])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String
  unitId    String

  name    String
  sku     String?
  barcode String?

  // Cached "current price" fields. Treat these as a read cache that is
  // always written in the same transaction as a new ProductPrice row —
  // ProductPrice.effectiveFrom/effectiveTo is the actual source of truth
  // for price history. Don't let a service update one without the other.
  price     Decimal?
  costPrice Decimal?

  image     String?
  isDefault Boolean @default(false)

  // FIX (new field): nothing previously declared how a variant is tracked,
  // even though the TrackingMode enum existed unused. This decides whether
  // ProductBatch rows are required/expected for a given variant.
  trackingMode TrackingMode @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  batches ProductBatch[]

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  transferItems TransferItem[]

  attributeValues VariantAttributeValue[]
  prices          ProductPrice[]

  stocks Stock[]

  // FIX: StockMovement.variant and AdjustmentItem.variant both relate to
  // ProductVariant, but the reverse list fields were missing here — same
  // class of error as the Product/StockMovement issue above.
  stockMovements  StockMovement[]
  adjustmentItems AdjustmentItem[]

  @@index([productId])
  @@unique([barcode])
}

model ProductAttribute {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ProductAttributeValue[]

  @@unique([businessId, name])
}

model ProductAttributeValue {
  id String @id @default(cuid())

  attributeId String
  value       String

  attribute ProductAttribute @relation(fields: [attributeId], references: [id])

  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
}

model VariantAttributeValue {
  id String @id @default(cuid())

  variantId String
  valueId   String

  variant ProductVariant         @relation(fields: [variantId], references: [id])
  value   ProductAttributeValue  @relation(fields: [valueId], references: [id])

  @@unique([variantId, valueId])
}

model ProductPrice {
  id        String @id @default(cuid())
  variantId String

  costPrice    Decimal
  sellingPrice Decimal

  effectiveFrom DateTime
  effectiveTo   DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, effectiveFrom])
}

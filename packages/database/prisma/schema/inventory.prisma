// INVARIANT: for a batch-tracked variant (ProductVariant.trackingMode = BATCH),
// Stock.quantity for a given (warehouseId, variantId) must always equal the
// sum of ProductBatch.quantity for that same warehouse+variant. Stock.quantity
// is a cached rollup for fast reads (dashboards, "how much X do we have"
// questions) — it is NOT an independent source of truth.
//
// Enforce this in code, not in the schema: every purchase, sale, transfer,
// and adjustment should go through one shared service function
// (e.g. applyStockMovement()) that, inside a single DB transaction:
//   1. writes/updates the relevant ProductBatch row(s) (if batch-tracked)
//   2. updates Stock.quantity to match
//   3. writes the StockMovement row with the resulting balanceAfter
// No other code path should be allowed to touch quantity fields directly —
// that's what will keep the AI layer's answers trustworthy.
model Stock {
  id String @id @default(cuid())

  warehouseId String
  variantId   String

  quantity Decimal @default(0)

  reservedQuantity Decimal @default(0)

  reorderLevel    Decimal?
  reorderQuantity Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  movements StockMovement[]

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model StockMovement {
  id String @id @default(cuid())

  businessId  String
  warehouseId String
  batchId     String?
  variantId   String
  stockId     String

  performedById String?

  quantity     Decimal
  balanceAfter Decimal

  type MovementType

  referenceType ReferenceType?
  referenceId   String?

  reason String?
  note   String?

  createdAt DateTime @default(now())

  business    Business       @relation(fields: [businessId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  stock       Stock          @relation(fields: [stockId], references: [id])
  performedBy User?          @relation(fields: [performedById], references: [id])
  batch       ProductBatch?  @relation(fields: [batchId], references: [id])

  // This will be your highest-volume, most-queried table (every "what
  // happened to my stock" and AI question hits it). Index the columns
  // you'll actually filter/sort by.
  @@index([businessId, warehouseId, variantId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

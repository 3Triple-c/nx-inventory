{
  "name": "nx-inventory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @nx-inventory/database generate",
    "db:migrate": "pnpm --filter @nx-inventory/database migrate",
    "db:deploy": "pnpm --filter @nx-inventory/database deploy",
    "db:studio": "pnpm --filter @nx-inventory/database studio",
    "db:reset": "pnpm --filter @nx-inventory/database reset",
    "postinstall": "pnpm --filter @nx-inventory/database generate"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  }
}
